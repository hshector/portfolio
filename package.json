{
  "name": "portfolio",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "library": "node scripts/library/build.ts",
    "build": "npm run library && npm run warrenia:build && astro build && pagefind --site dist --output-subdir pagefind",
    "build:site": "npm run warrenia:build && astro build && pagefind --site dist --output-subdir pagefind",
    "check": "astro check && tsc --noEmit -p src/warrenia-app",
    "check:dist": "node scripts/check-dist.ts",
    "preview": "wrangler dev --port 4321 --ip 127.0.0.1",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "deploy": "wrangler deploy",
    "deploy:dry": "wrangler deploy --dry-run",
    "warrenia:data": "bash scripts/warrenia/data.sh",
    "warrenia:build": "vite build -c vite.warrenia.config.ts"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.4",
    "@fontsource-variable/bricolage-grotesque": "5.2.10",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@fontsource-variable/hanken-grotesk": "5.2.8",
    "@fontsource-variable/inter": "5.2.6",
    "@fontsource-variable/jetbrains-mono": "5.2.8",
    "@tanstack/react-virtual": "3.13.12",
    "astro": "7.3.8",
    "katex": "0.16.47",
    "lightweight-charts": "5.0.9",
    "next-themes": "0.4.6",
    "radix-ui": "1.4.3",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "rehype-katex": "7.0.1",
    "rehype-stringify": "10.0.1",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "sonner": "2.0.8",
    "three": "0.186.1",
    "unified": "11.0.5",
    "unist-util-visit": "5.1.0",
    "vfile": "6.0.3",
    "yaml": "2.9.1",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.11",
    "@fontsource/bricolage-grotesque": "5.3.0",
    "@gltf-transform/cli": "4.5.1",
    "@playwright/test": "1.56.1",
    "@tailwindcss/postcss": "4.1.14",
    "@types/node": "22.20.5",
    "@types/opentype.js": "1.3.10",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.1.2",
    "ngraph.forcelayout": "3.3.1",
    "ngraph.graph": "20.1.2",
    "opentype.js": "2.0.0",
    "pagefind": "1.5.2",
    "tailwindcss": "4.1.14",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "5.0.5",
    "wrangler": "4.148.0"
  }
}
