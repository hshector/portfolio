---
// WarrenIA itself (src/warrenia-app, built into /warrenia-app/): the real app's screens with last
// night's public analysis, in a frame. variant "island": over the pavilion's screen, hidden until
// the visit opens it (src/island/warrenia.ts creates the frame then); "page": on /warrenia, the
// version without 3D.
interface Props { variant: 'island' | 'page' }
const { variant } = Astro.props;
---
{variant === 'island' ? (
  <div class="wdemo-host island" data-warrenia hidden>
    <div class="wdemo-bar">
      <button type="button" data-warrenia-close>← Volver al toro</button>
      <span>WarrenIA · el análisis real de anoche, sin precios</span>
      <a href="/warrenia-app/" target="_blank" rel="noopener" data-warrenia-full>Pantalla completa ↗</a>
    </div>
  </div>
) : (
  <div class="wdemo-host page" data-warrenia>
    <iframe src="/warrenia-app/" title="WarrenIA (demo)" loading="lazy"></iframe>
  </div>
)}

<style is:global>
  .wdemo-host { display: grid; grid-template-rows: auto 1fr; background: #f3f4f1; overflow: hidden; border-radius: 28px; }
  .wdemo-host iframe { width: 100%; height: 100%; border: 0; display: block; background: #f3f4f1; }
  .wdemo-host.page { height: min(860px, 90svh); border: 1px solid var(--line); grid-template-rows: 1fr; }
  .wdemo-bar {
    display: flex; align-items: center; gap: 12px; min-height: 44px; padding: 0 10px 0 6px;
    font: 500 13px/1.2 -apple-system, BlinkMacSystemFont, 'Inter Variable', system-ui, sans-serif;
    color: #686b66; background: #e8eae5; border-bottom: 1px solid rgb(17 17 17 / 0.08);
  }
  .wdemo-bar span { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .wdemo-bar button, .wdemo-bar a {
    display: inline-flex; align-items: center; min-height: 32px; padding: 0 12px; border-radius: 99px;
    font: inherit; font-weight: 600; color: #111; background: #fff; border: 0; cursor: pointer; text-decoration: none; white-space: nowrap;
  }
  .wdemo-bar button { color: #fff; background: #527f62; }
  .wdemo-host.island { position: absolute; z-index: 6;
    box-shadow: 0 30px 80px rgb(0 0 0 / 0.45), 0 0 0 1px rgb(255 255 255 / 0.5);
    opacity: 0; scale: 0.96; transition: opacity 0.45s ease, scale 0.45s ease; }
  .wdemo-host.island[data-open] { opacity: 1; scale: 1; }
  .wdemo-host.island[hidden] { display: none; }
  /* phones: the whole screen */
  @media (max-width: 720px) {
    .wdemo-host.island { inset: 0 !important; width: auto !important; height: auto !important; border-radius: 0; padding-top: env(safe-area-inset-top, 0px); }
    .wdemo-bar span, .wdemo-bar [data-warrenia-full] { display: none; }
    .wdemo-bar { justify-content: flex-start; }
  }
  @media (prefers-reduced-motion: reduce) { .wdemo-host.island { transition: none; } }
</style>
