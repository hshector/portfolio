---
import 'katex/dist/katex.min.css';
import '@fontsource-variable/hanken-grotesk/wght-italic.css';
import ConstellationUI from '../components/ConstellationUI.astro';
import WarreniaDemo from '../components/WarreniaDemo.astro';
import { num } from '../lib/format';
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { author, warrenia } from '../data/site';
import { library } from '../lib/library';
import { THEMES } from '../lib/themes';

const { report } = library();
const notes = report.books + report.concepts;
// what each place says when the bull reaches its door (src/island/app.ts)
const places = {
  muelle: { title: `La isla de ${author.name}`, text: 'Lleva al toro a los tres lugares de la isla, o abre el mapa para ir directo.', action: 'Abrir el mapa' },
  warrenia: { title: 'Pabellón WarrenIA', text: 'Sistema personal de inteligencia financiera: la app de verdad, con el análisis de anoche.', action: 'Entrar en WarrenIA', href: '/warrenia' },
  taller: { title: 'En obras · Próximamente', text: 'Aquí se está levantando el próximo proyecto. Todavía no se puede contar nada: vuelve pronto.', action: '' },
  observatorio: { title: 'Observatorio · La biblioteca', text: `${num(notes)} notas de ${num(report.books)} libros. Sube y recórrelas como una constelación.`, action: 'Subir al observatorio', href: '/constelacion' },
};
---
<Base
  title={`${author.name} · proyectos`}
  description="Una isla en 3D que se recorre a lomos de un toro: WarrenIA, un sistema personal de inteligencia financiera, y una biblioteca de 48 libros y más de 3.000 conceptos conectados."
>
  <section class="island" data-island data-state="loading" aria-label={`La isla de ${author.name} en 3D`}>
    <canvas class="island-canvas" tabindex="0" aria-label="Isla en 3D con un toro negro. Muévelo con WASD o las flechas; la lista de lugares está en «Saltar a…» y en el mapa."></canvas>
    <div class="joystick" data-joystick hidden><i></i></div>

    <header class="top">
      <span class="brand">{author.name}</span>
      <details class="skip">
        <summary>Saltar a…</summary>
        <ul>
          <li><a href="/warrenia" data-island-go="warrenia">WarrenIA</a></li>
          <li><a href="/constelacion" data-island-go="observatorio">La biblioteca (constelación)</a></li>
          <li><a href="#proyectos" data-island-go="obra">En obras: próximamente</a></li>
        </ul>
      </details>
      <div class="tools">
        <button class="icon-btn" type="button" data-sound aria-pressed="false" aria-label="Activar el sonido" title="Activar el sonido">
          <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M4 9.5h3.2L12 5.5v13l-4.8-4H4z" fill="currentColor" stroke="none" />
            <g class="waves"><path d="M15.5 9a4.5 4.5 0 0 1 0 6" /><path d="M18 6.5a8 8 0 0 1 0 11" /></g>
            <g class="mute"><path d="m16 9.5 5 5M21 9.5l-5 5" /></g>
          </svg>
        </button>
        <button class="icon-btn" type="button" data-map-open aria-label="Mapa de la isla" title="Mapa (M)">
          <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"><path d="M3 6.5 9 4l6 2.5L21 4v13.5L15 20l-6-2.5L3 20z" /><path d="M9 4v13.5M15 6.5V20" /></svg>
        </button>
      </div>
    </header>

    <div class="prompt" data-prompt hidden>
      <h2 data-prompt-title></h2>
      <p data-prompt-text></p>
      <a class="go" data-prompt-go href="#"></a>
      <span class="key" aria-hidden="true">E</span>
    </div>

    <p class="hint" data-hint>
      <span class="keys">W o ↑ para andar · A D para girar · Mayús para galopar · E para entrar · M mapa</span>
      <span class="touch">Arrastra para mover al toro: cuanto más lejos, más rápido</span>
    </p>

    <button class="icon-btn view" type="button" data-view aria-pressed="false" aria-label="Vista satélite" title="Vista satélite">
      <svg class="to-sky" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"><rect x="9" y="9" width="6" height="6" rx="1" transform="rotate(45 12 12)" /><path d="m5 5 3.5 3.5M15.5 15.5 19 19M3 7l4-4M17 21l4-4" /><path d="M19.5 9a5 5 0 0 0-4.5-4.5" stroke-linecap="round" /></svg>
      <svg class="to-bull" viewBox="0 0 24 24" aria-hidden="true" fill="currentColor"><path d="M20.5 3.5 3.8 10.3c-.7.3-.6 1.3.1 1.5l6.6 1.7 1.7 6.6c.2.7 1.2.8 1.5.1z" /></svg>
    </button>

    <ConstellationUI variant="island" />
    <WarreniaDemo variant="island" />
    <p class="debug" data-debug hidden></p>
    <p class="loading" role="status">Levantando la isla…</p>

    <div class="fallback">
      <p class="calm-only">Has pedido menos movimiento en tu sistema, así que la isla en 3D está en pausa.</p>
      <p class="nogl-only">Tu navegador no puede mostrar la isla en 3D.</p>
      <div class="actions">
        <button class="go calm-only" type="button" data-enter>Entrar en la isla igualmente</button>
        <a class="go" href="#proyectos">Ver los proyectos</a>
      </div>
    </div>

    <dialog class="map" data-map aria-labelledby="map-title">
      <header><h2 id="map-title">Mapa de la isla</h2><form method="dialog"><button class="icon-btn" aria-label="Cerrar el mapa">✕</button></form></header>
      <canvas data-map-canvas width="440" height="440" aria-hidden="true"></canvas>
      <ul class="places">
        <li><button type="button" data-go="warrenia">Ir al Pabellón WarrenIA</button><a href="/warrenia" data-island-go="warrenia">o entrar ya</a></li>
        <li><button type="button" data-go="taller">Ir a la obra (próximamente)</button></li>
        <li><button type="button" data-go="observatorio">Ir al Observatorio</button><a href="/constelacion" data-island-go="observatorio">o subir ya</a></li>
        <li><button type="button" data-go="muelle">Volver al muelle</button></li>
      </ul>
    </dialog>
    <noscript><div class="fallback show"><p>La isla en 3D necesita JavaScript.</p><a class="go" href="#proyectos">Ver los proyectos</a></div></noscript>
    <script type="application/json" data-places set:html={JSON.stringify(places)} />
  </section>

  <div class="page" id="proyectos">
    <SiteHeader />
    <main>
      <header class="hero">
        <p class="eyebrow">Proyectos</p>
        <h1>{author.name}</h1>
        <p class="lede">Un sistema de inteligencia financiera y una biblioteca de notas de lectura.</p>
      </header>

      <section class="projects" aria-label="Proyectos">
        <article class="card" aria-labelledby="w-title">
          <p class="kicker">Obra I</p>
          <h2 id="w-title">{warrenia.name}</h2>
          <p>{warrenia.summary}</p>
          <ul class="tags" aria-label="Tecnologías">
            {warrenia.stack.map((s) => <li>{s}</li>)}
          </ul>
          <p class="facts">{warrenia.facts.join(' · ')}</p>
          <a class="link" href="/warrenia">Ver el proyecto</a>
        </article>

        <article class="card" aria-labelledby="b-title">
          <p class="kicker">Biblioteca</p>
          <h2 id="b-title">Notas de lectura</h2>
          <p>
            {num(report.books)} libros y {num(report.concepts)} conceptos unidos por {num(report.links)} enlaces.
            Se pueden recorrer como una constelación en 3D.
          </p>
          <a class="link" href="/constelacion">Ver la constelación</a>
          <a class="link" href="/biblioteca">Entrar en la biblioteca</a>
          <ul class="themes" aria-label="Temáticas">
            {THEMES.map((t) => <li data-mark={t.mark} style={`--c: ${t.color}`}><i aria-hidden="true"></i>{t.name}</li>)}
          </ul>
        </article>
      </section>

      <footer>
        <p>
          Toro: «<a href="https://sketchfab.com/3d-models/bull-walk-cycle-d59e56bc90a34bcd826d02798a54ac96">bull walk cycle</a>» de
          <a href="https://sketchfab.com/Leafalu">Lucy Greenhill</a>,
          <a href="https://creativecommons.org/licenses/by/4.0/">CC BY 4.0</a>, recoloreado en negro; sus pasos se generan por código con la tabla de pasos de <a href="https://github.com/majidmanzarpour/threejs-procedural-animals">threejs-procedural-animals</a> (MIT).
          Letras: Bricolage Grotesque (SIL OFL 1.1). Sonido sintetizado en el navegador.
        </p>
      </footer>
    </main>
  </div>
</Base>

<script>
  const root = document.querySelector<HTMLElement>('[data-island]')!;
  const places = JSON.parse(root.querySelector('[data-places]')!.textContent!);
  const webgl = (() => {
    try { const c = document.createElement('canvas'); return !!(c.getContext('webgl2') || c.getContext('webgl')); } catch { return false; }
  })();
  const calm = matchMedia('(prefers-reduced-motion: reduce)').matches && !new URLSearchParams(location.search).has('isla');
  async function enter() {
    root.dataset.state = 'loading';
    try {
      const { startIsland } = await import('../island/app');
      await startIsland({ root, places });
    } catch (err) {
      console.error(err);
      root.dataset.state = 'nogl';
    }
  }
  if (!webgl) root.dataset.state = 'nogl';
  else if (calm) root.dataset.state = 'calm';
  else enter();
  root.querySelector('[data-enter]')!.addEventListener('click', enter);
</script>

<style>
  /* ---- the island: full screen, edge to edge */
  .island {
    position: relative; height: 100svh; min-height: 480px; overflow: hidden; background: #2a2453;
    margin-inline: calc(var(--gutter) * -1) calc(max(16px, env(safe-area-inset-right, 0px)) * -1);
    background: linear-gradient(#2a2453, #ff9a62 55%, #b8934a 56%, #93783d);
  }
  .island-canvas { position: absolute; inset: 0; width: 100%; height: 100%; display: block; touch-action: none; outline: none; }
  .island > :not(canvas):not(dialog):not(script) { z-index: 2; }

  .top { position: absolute; top: max(12px, env(safe-area-inset-top, 0px)); left: 14px; right: 14px; display: flex; align-items: flex-start; gap: 10px; }
  .brand { font: 700 var(--step-0) / 1 var(--f-display); text-decoration: none; color: #fff; padding: 10px 2px; text-shadow: 0 1px 12px rgb(0 0 0 / 0.35); }
  .tools { margin-left: auto; display: flex; gap: 8px; }
  .glass, .skip summary, .icon-btn, .prompt, .hint, .skip ul {
    color: #f4f5fb; background: rgb(10 11 20 / 0.42); border: 1px solid rgb(255 255 255 / 0.16);
    backdrop-filter: blur(12px) saturate(1.4); -webkit-backdrop-filter: blur(12px) saturate(1.4);
  }
  .skip { position: relative; }
  .skip summary { list-style: none; cursor: pointer; font: 600 13px/1 var(--f-body); padding: 11px 14px; border-radius: 99px; }
  .skip summary::-webkit-details-marker { display: none; }
  .skip ul { position: absolute; top: calc(100% + 6px); left: 0; margin: 0; padding: 6px; list-style: none; border-radius: 14px; min-width: 200px; }
  .skip a { display: block; padding: 9px 12px; border-radius: 9px; text-decoration: none; font-size: 14px; }
  .skip a:hover { background: rgb(255 255 255 / 0.1); }

  .icon-btn { width: 40px; height: 40px; display: grid; place-items: center; padding: 0; border-radius: 50%; cursor: pointer; transition: background 0.2s, transform 0.15s; }
  .icon-btn:hover { background: rgb(10 11 20 / 0.62); }
  .icon-btn:active { transform: scale(0.94); }
  .icon-btn svg { width: 20px; height: 20px; }
  [data-sound] .waves { display: none; }
  [data-sound][aria-pressed='true'] .waves { display: inline; }
  [data-sound][aria-pressed='true'] .mute { display: none; }
  .view { position: absolute; right: 14px; bottom: max(14px, env(safe-area-inset-bottom, 0px)); }
  .view svg { position: absolute; transition: opacity 0.3s, transform 0.4s cubic-bezier(0.5, 1.4, 0.4, 1); }
  .view .to-bull { opacity: 0; transform: scale(0.6) rotate(-30deg); }
  .view[aria-pressed='true'] .to-sky { opacity: 0; transform: scale(0.6) rotate(30deg); }
  .view[aria-pressed='true'] .to-bull { opacity: 1; transform: none; }

  .prompt { position: absolute; left: 14px; bottom: max(14px, env(safe-area-inset-bottom, 0px)); width: min(380px, calc(100% - 84px)); border-radius: 18px; padding: 16px 18px; display: grid; gap: 8px; animation: rise 0.35s ease-out; }
  .prompt h2 { font: 700 18px/1.15 var(--f-display); }
  .prompt p { font-size: 14px; color: rgb(244 245 251 / 0.82); }
  .prompt[data-no-action] :is(.go, .key) { display: none; }
  .prompt .key { position: absolute; right: 14px; top: 14px; font: 600 11px/1 var(--f-mono); padding: 5px 7px; border-radius: 6px; border: 1px solid rgb(255 255 255 / 0.3); }
  @media (pointer: coarse) { .prompt .key { display: none; } }
  @keyframes rise { from { opacity: 0; transform: translateY(8px); } }
  .go { justify-self: start; font: 600 14px/1 var(--f-body); color: #0b0c14; background: linear-gradient(120deg, var(--dusk), var(--dusk-2)); border: 0; border-radius: 99px; padding: 11px 16px; text-decoration: none; cursor: pointer; }

  .hint { position: absolute; left: 50%; bottom: max(16px, env(safe-area-inset-bottom, 0px)); transform: translateX(-50%); font-size: 12.5px; padding: 8px 14px; border-radius: 99px; white-space: nowrap; pointer-events: none; transition: opacity 0.8s; }
  .hint[data-done] { opacity: 0; }
  .hint .touch { display: none; }
  @media (pointer: coarse) { .hint .keys { display: none; } .hint .touch { display: inline; } .hint { white-space: normal; text-align: center; width: calc(100% - 130px); border-radius: 14px; } }
  .island:has(.prompt:not([hidden])) .hint { opacity: 0; }

  .joystick { position: absolute; width: 112px; height: 112px; margin: -56px 0 0 -56px; border-radius: 50%; border: 1.5px solid rgb(255 255 255 / 0.5); background: rgb(10 11 20 / 0.25); pointer-events: none; }
  .joystick i { position: absolute; left: 50%; top: 50%; width: 46px; height: 46px; margin: -23px; border-radius: 50%; background: rgb(255 255 255 / 0.75); transform: translate(var(--kx, 0), var(--ky, 0)); }

  .debug { position: absolute; left: 14px; bottom: 14px; font: 500 11px/1 var(--f-mono); color: rgb(244 245 251 / 0.7); pointer-events: none; }
  .loading { position: absolute; inset: 0; display: grid; place-items: center; color: #fff; font-size: 15px; text-shadow: 0 1px 10px rgb(0 0 0 / 0.4); pointer-events: none; transition: opacity 0.6s; }
  .island[data-state='ready'] .loading, .island[data-state='nogl'] .loading, .island[data-state='calm'] .loading { opacity: 0; }
  /* up in the sky (or on the way): the island's controls step aside */
  .island .top, .island .view, .island .hint { transition: opacity 0.5s ease; }
  .island[data-visit]:not([data-visit='island']) :is(.top, .view, .hint, .prompt, .joystick) { opacity: 0; pointer-events: none; }
  /* with the island running, everything happens in it: the page below is only for the version without 3D */
  .island[data-state='ready'] ~ .page { display: none; }
  .island:not([data-state='ready']) .top .tools, .island:not([data-state='ready']) .view, .island:not([data-state='ready']) .hint { visibility: hidden; }

  .fallback { position: absolute; inset: 0; display: none; place-content: center; justify-items: center; gap: 16px; text-align: center; padding: 24px; color: #fff; }
  .fallback .actions { display: flex; flex-wrap: wrap; gap: 10px; justify-content: center; }
  .island[data-state='nogl'] .fallback, .island[data-state='calm'] .fallback, .fallback.show { display: grid; }
  .island[data-state='nogl'] .calm-only, .island[data-state='calm'] .nogl-only { display: none; }

  .map { width: min(480px, calc(100% - 24px)); max-height: calc(100dvh - 24px); padding: 18px; border-radius: 20px; border: 1px solid var(--line); background: #0c0e1c; color: var(--ink); }
  .map::backdrop { background: rgb(5 6 13 / 0.55); backdrop-filter: blur(4px); }
  .map header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px; }
  .map h2 { font-size: 20px; }
  .map canvas { width: 100%; height: auto; aspect-ratio: 1; border-radius: 14px; display: block; }
  .places { list-style: none; margin: 14px 0 0; padding: 0; display: grid; gap: 8px; }
  .places li { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 12px; }
  .places button { font: 600 14px/1 var(--f-body); color: var(--ink); background: rgb(255 255 255 / 0.08); border: 1px solid var(--line); border-radius: 99px; padding: 10px 14px; cursor: pointer; }
  .places button:hover { background: rgb(255 255 255 / 0.14); }
  .places a { font-size: 13.5px; color: var(--ink-2); }

  /* ---- the page under the island */
  .page main { max-width: 1040px; margin: 0 auto; padding-block: clamp(48px, 10vw, 120px) 64px; display: grid; gap: clamp(40px, 7vw, 80px); }
  .hero { display: grid; gap: 18px; max-width: 46rem; }
  .eyebrow, .kicker { font: 600 var(--step--1) / 1 var(--f-mono); letter-spacing: 0.1em; text-transform: uppercase; color: var(--dusk); }
  h1 { font-size: var(--step-3); font-weight: 800; line-height: 0.95; letter-spacing: -0.02em; }
  .lede { font-size: var(--step-1); color: var(--ink-2); max-width: 36rem; }
  .projects { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 340px), 1fr)); gap: 20px; }
  .card { display: grid; gap: 14px; align-content: start; padding: clamp(20px, 3vw, 32px); border: 1px solid var(--line); border-radius: var(--radius); background: linear-gradient(160deg, rgb(255 255 255 / 0.05), rgb(255 255 255 / 0.01)); min-width: 0; }
  .card h2 { font-size: var(--step-1); font-weight: 700; }
  .card p { color: var(--ink-2); }
  .tags, .themes { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .tags li { font: 500 var(--step--1) / 1 var(--f-mono); padding: 7px 10px; border-radius: 99px; border: 1px solid var(--line); color: var(--ink-2); }
  .themes li { display: inline-flex; align-items: center; gap: 8px; font-size: var(--step--1); padding: 6px 11px; border-radius: 99px; background: rgb(255 255 255 / 0.04); }
  .themes i { width: 10px; height: 10px; border-radius: 50%; background: var(--c); box-shadow: 0 0 10px var(--c); }
  .themes li[data-mark='ring'] i { background: transparent; border: 2px solid var(--c); box-shadow: none; }
  .card .kicker { color: var(--dusk-2); }
  .facts { font: 500 var(--step--1) / 1.4 var(--f-mono); color: var(--ink) !important; }
  .link { justify-self: start; color: var(--ink); text-underline-offset: 4px; }
  footer { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 12px; color: var(--ink-3); font-size: var(--step--1); border-top: 1px solid var(--line); padding-top: 20px; }
  footer p { max-width: 60ch; }
</style>
